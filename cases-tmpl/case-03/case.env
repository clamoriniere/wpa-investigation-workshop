# Metadata used by case.sh. Rendered through the same __TOKEN__ substitution as
# the manifests before being sourced.
CASE_TITLE="A WPA that agrees it should scale, and doesn't"
WPA_NAME="case03-app"
DEPLOYMENT="case03-app"
# The load generator holds the queue-depth gauge at 50 against a 20-40 band, so
# a working WPA computes ceil(1 * 50/40) = 2 on the first reconcile, then
# 50/2 = 25 sits inside the band and it settles there.
EXPECTED_MIN_REPLICAS=2
# The query as the Cluster Agent builds it: labels sorted alphabetically, avg
# aggregator, 30s rollup. Unlike cases 01 and 02 this query was never wrong.
DD_QUERY='avg:wpa_workshop.queue.depth{case:__CASE_ID__,workshop_name:__WORKSHOP_NAME__}.rollup(30)'
