# Metadata used by case.sh. Rendered through the same __TOKEN__ substitution as
# the manifests before being sourced.
CASE_TITLE="A WPA that scales, then stops well short of where the metric wants it"
WPA_NAME="case04-app"
DEPLOYMENT="case04-app"
# The load generator holds the metric at 180 against a 20-40 band. Unconstrained,
# average lands it at N=5 (180/5=36, inside the band). EXPECTED_MIN_REPLICAS is
# that converged value, not just "more than the broken ceiling" — a fix that
# still caps below 5 does not count as solved.
EXPECTED_MIN_REPLICAS=5
# The query as the Cluster Agent builds it: labels sorted alphabetically, avg
# aggregator, 30s rollup. This query was never wrong — nothing about this case
# is metric-side.
DD_QUERY='avg:wpa_workshop.orders.processing_lag{case:__CASE_ID__,workshop_name:__WORKSHOP_NAME__}.rollup(30)'
