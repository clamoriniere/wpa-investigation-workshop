# Metadata used by case.sh. Rendered through the same __TOKEN__ substitution as
# the manifests before being sourced.
CASE_TITLE="A WPA that scaled fine for months, and now won't move at all"
WPA_NAME="case06-app"
DEPLOYMENT="case06-app"
# The load generator holds the queue-depth gauge at 100 against a 40-80 band, so
# a working WPA computes ceil(1 * 100/80) = 2 on the first reconcile, then
# 100/2 = 50 sits inside the band and it settles there.
EXPECTED_MIN_REPLICAS=2
# The query as the Cluster Agent serves it once the DatadogMetric's own spec.query
# is corrected: labels sorted alphabetically, avg aggregator, 30s rollup. This is
# the same string that belongs in the DatadogMetric object, not just the WPA.
DD_QUERY='avg:wpa_workshop.orders.queue_depth{case:__CASE_ID__,queue:orders-v2,workshop_name:__WORKSHOP_NAME__}.rollup(30)'
