# Metadata used by case.sh. Rendered through the same __TOKEN__ substitution as
# the manifests before being sourced.
CASE_TITLE="A WPA that refuses to scale down no matter how idle things get"
WPA_NAME="case05-app"
DEPLOYMENT="case05-app"
# This case's success is a DOWNSCALE, the opposite shape of every other case, so
# the shared "currentReplicas >= EXPECTED_MIN_REPLICAS" check does not apply —
# the broken state already sits at 4, comfortably above any floor. check.sh
# looks at EXPECTED_MAX_REPLICAS instead. The load generator holds the metric
# at 5 against a 20-40 band, so a fixed WPA has nothing pulling it above
# minReplicas=1: 5/1=5 is still below the low watermark, and it settles there.
EXPECTED_MAX_REPLICAS=1
# The query as the Cluster Agent builds it: labels sorted alphabetically, avg
# aggregator, 30s rollup. This query was never wrong.
DD_QUERY='avg:wpa_workshop.checkout.queue_depth{case:__CASE_ID__,workshop_name:__WORKSHOP_NAME__}.rollup(30)'
