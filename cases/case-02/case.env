# Metadata used by case.sh. Rendered through the same __TOKEN__ substitution as
# the manifests before being sourced.
CASE_TITLE="A WPA that cannot read a metric that is definitely collected"
WPA_NAME="case02-app"
DEPLOYMENT="case02-app"
# nginx's memory usage sits well above the 1M high watermark, so a working WPA
# scales up towards maxReplicas.
EXPECTED_MIN_REPLICAS=2
# The query as the Cluster Agent builds it once the selector is correct: labels
# sorted alphabetically, avg aggregator, 30s rollup.
DD_QUERY='avg:container.memory.usage{kube_container_name:web,kube_deployment:case02-app,kube_namespace:__CASE_NAMESPACE__}.rollup(30)'
