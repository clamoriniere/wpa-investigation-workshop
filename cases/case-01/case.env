# Metadata used by case.sh. Rendered through the same __TOKEN__ substitution as
# the manifests before being sourced.
CASE_TITLE="A WPA that never scales, on a metric that is clearly hot"
WPA_NAME="case01-app"
DEPLOYMENT="case01-app"
# The metric sits at 90 against a high watermark of 60, so a working WPA
# proposes ceil(1 * 90 / 60) = 2 replicas.
EXPECTED_MIN_REPLICAS=2
DD_QUERY='avg:wpa_workshop.app.load{case:__CASE_ID__,workshop_name:__WORKSHOP_NAME__}.rollup(30)'
